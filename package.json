{
	"name": "pi-request-command",
	"version": "0.1.0",
	"description": "Ask the user to run a shell command in their own terminal and report the result, so the agent never holds privileges",
	"keywords": [
		"pi-package",
		"pi",
		"sudo",
		"command",
		"approval",
		"human-in-the-loop"
	],
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@earendil-works/pi-coding-agent": "1.2.0",
		"@types/node": "^24.0.0",
		"knip": "6.39.0",
		"lefthook": "2.1.14",
		"typebox": "1.3.34",
		"typescript": "7.0.2"
	},
	"scripts": {
		"check": "biome check . && tsc --noEmit",
		"fix": "biome check --write .",
		"knip": "knip --no-config-hints",
		"test": "node --test \"test/**/*.test.ts\"",
		"test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=80 --test-coverage-functions=80 \"test/unit/**/*.test.ts\" \"test/integration/**/*.test.ts\"",
		"verify": "npm run check && npm run knip && npm test && npm run test:coverage"
	}
}
